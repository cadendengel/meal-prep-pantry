# MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers. Replace <password> with the real
# database user password, and URL-encode any reserved characters in it.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority"

# Secret used to sign JWTs. Use 32 or more random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value logs out every user.
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Override the API base URL the front end calls.
# Leave this unset for a normal Vercel deployment, where the front end and
# the API share one origin.
# VITE_API_URL="/api"

# ---------------------------------------------------------------------------
# Password reset email (optional)
# ---------------------------------------------------------------------------
# Sent through Gmail SMTP, so the app can send as a real Gmail address.
# Without these, the reset endpoint still works and logs the link to the
# server console instead of sending it.
#
# GMAIL_APP_PASSWORD is a Google App Password, NOT the account password.
# Enable 2-Step Verification on the account, then:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Google shows it as four groups of four. The spaces are ignored.
# GMAIL_USER="mealpreppantry@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# Display name on the From header. The address is always GMAIL_USER,
# because Gmail sends as the authenticated account.
# MAIL_FROM_NAME="Meal Prep Pantry"

# The origin used to build reset links. Defaults to the request host.
# APP_ORIGIN="https://your-app.vercel.app"
