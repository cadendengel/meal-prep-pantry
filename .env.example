# MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers. Replace <password> with the real
# database user password, and URL-encode any reserved characters in it.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority"

# Secret used to sign JWTs. Use 32 or more random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value logs out every user.
JWT_SECRET="replace-with-a-long-random-string"

# Optional. Override the API base URL the front end calls.
# Leave this unset for a normal Vercel deployment, where the front end and
# the API share one origin.
# VITE_API_URL="/api"
